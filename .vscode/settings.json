    "**/*.log": true,
    "internships_project/data/**": true,
    "data/internships_cache*.json": true,
    ".agents/**": true,
    ".city-worktrees/**": true,
    ".codex/**": true,
    ".agent-test-*/**": true,
    ".test-*/**": true,
    ".pytest-tmp-*/**": true,
    "t[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/**": true,
    "tuicj/**": true,
    "tuirv/**": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "app.py": "run_local.ps1",
    "app_internships.py": "run_internships.ps1"
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    ".codex-tools/**": true,
    ".city-worktrees/**": true,
    "artifacts/**": true,
    "graphify-out/**": true,
    "internships_project/data/**": true
