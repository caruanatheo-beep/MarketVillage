    ".agent-test-*": true,
    ".test-*": true,
    ".pytest-tmp-*": true,
    "t[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]": true,
    "tuicj": true,
    "tuirv": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/*.pyc": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/node_modules/**": true,
