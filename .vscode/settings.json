{
  "files.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "**/dist": true,
    ".marketdesk_pytest_tmp": true,
    ".pytest_city_final2": true,
    ".codex-tools": true,
    "artifacts": true,
    "graphify-out": true,
    "markets-career-desk": true,
    "**/*.log": true,
